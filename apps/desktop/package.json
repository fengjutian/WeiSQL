{
  "name": "@weisql/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "WeiSQL Desktop — Tauri client for WeiSQL data packages",
  "type": "module",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "dev": "node scripts/prepare-assets.mjs && vite",
    "build": "node scripts/prepare-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node test/ui.e2e.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@weisql/duckdb-wasm-adapter": "0.1.0",
    "@weisql/sdk": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
