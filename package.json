{
  "name": "weisql-ai-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @weisql/sdk && npm run build --workspace @weisql/duckdb-adapter && npm run build --workspace @weisql/duckdb-wasm-adapter && npm run build --workspace @weisql/usearch-adapter && npm run build --workspace @weisql/cli",
    "test": "npm run build && npm run test --workspace @weisql/sdk && npm run test --workspace @weisql/duckdb-adapter && npm run test --workspace @weisql/duckdb-wasm-adapter && npm run test --workspace @weisql/usearch-adapter && npm run test --workspace @weisql/cli",
    "test:watch": "npm run build && npm run test:watch --workspace @weisql/sdk",
    "test:contract": "npm run build && node tools/sql-contract/run.mjs",
    "typecheck": "npm run typecheck --workspace @weisql/sdk && npm run typecheck --workspace @weisql/duckdb-adapter && npm run typecheck --workspace @weisql/duckdb-wasm-adapter && npm run typecheck --workspace @weisql/usearch-adapter && npm run typecheck --workspace @weisql/cli",
    "fixture": "npm run build --workspace @weisql/sdk && node examples/build-fixture.mjs",
    "source:parquet": "python tools/make-source-parquet.py",
    "probe:browser": "node tools/browser-probe/run.mjs",
    "probe:wasm": "node tools/browser-probe/run-wasm.mjs",
    "probe:wasm-vector": "node tools/browser-probe/run-wasm-vector.mjs",
    "test:wasm-vector-scenario": "node tools/browser-probe/check-wasm-vector-scenario.mjs",
    "probe:opfs-lock": "node tools/browser-probe/run-opfs-lock.mjs",
    "probe:cdn": "node tools/cdn-probe.mjs",
    "vendor:wasm-extension": "node tools/fetch-duckdb-wasm-extension.mjs",
    "playground": "node tools/browser-probe/serve.mjs",
    "probe:playground": "node tools/browser-probe/run-playground.mjs",
    "probe:parity": "node tools/browser-probe/parity.mjs",
    "bench": "node tools/bench/run.mjs",
    "bench:wasm": "node --expose-gc tools/bench/wasm.mjs",
    "bench:wasm-stream": "node tools/browser-probe/run-stream-bench.mjs",
    "bench:wasm-cold": "node tools/browser-probe/run-cold-bench.mjs",
    "bench:quantization": "node tools/bench/quantization.mjs",
    "bench:recall": "node tools/bench/recall.mjs",
    "bench:self-test": "node tools/bench/quantization.mjs --self-test && node tools/bench/recall.mjs --self-test",
    "test:rust-golden": "node tools/bench/rust-golden.mjs",
    "build:wasm": "cargo build --locked --release --target wasm32-unknown-unknown --manifest-path crates/vector-wasm/Cargo.toml",
    "test:wasm-golden": "node tools/bench/wasm-baseline.mjs",
    "test:wasm-adapter": "node tools/bench/wasm-adapter.mjs",
    "build:hnsw-wasm": "cargo build --locked --release --target wasm32-unknown-unknown --manifest-path crates/vector-hnsw-wasm/Cargo.toml",
    "test:hnsw-wasm": "node tools/bench/hnsw-wasm.mjs",
    "test:hnsw-adapter": "node tools/bench/hnsw-adapter.mjs",
    "bench:hnsw-dataset": "node tools/bench/hnsw-dataset.mjs",
    "test:hnsw-dataset": "node tools/bench/hnsw-dataset.mjs --rows 500 --dim 8 --queries 5 --min-recall 0.9 --wasm packages/sdk/wasm/weisql_vector_hnsw_wasm.wasm",
    "build:ann-index": "node tools/build-ann-index.mjs",
    "build:hnsw-index": "node tools/build-hnsw-index.mjs",
    "test:hnsw-package": "node tools/bench/hnsw-package.mjs",
    "embed:wasm": "node tools/embed-wasm.mjs",
    "embed:wasm:check": "node tools/embed-wasm.mjs --check",
    "release:check": "node tools/release-check.mjs",
    "release:pack": "node tools/check-tarballs.mjs",
    "release:e2e": "node tools/pack-e2e.mjs",
    "release:pack:self-test": "node tools/check-tarballs.mjs --self-test",
    "release:publish": "node tools/publish.mjs",
    "docs:install": "npm --prefix website install",
    "docs:dev": "npm --prefix website run dev",
    "docs:build": "npm --prefix website run build",
    "docs:serve": "npm --prefix website run serve",
    "frameworks:install": "npm ci --prefix examples/frameworks/vite-react && npm ci --prefix examples/frameworks/vite-vue && npm ci --prefix examples/frameworks/sveltekit",
    "test:frameworks": "node examples/frameworks/run.mjs",
    "desktop:dev": "npm run tauri:dev --workspace @weisql/desktop",
    "desktop:build": "npm run tauri:build --workspace @weisql/desktop",
    "desktop:web": "npm run dev --workspace @weisql/desktop",
    "desktop:test": "npm run test:e2e --workspace @weisql/desktop"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "hyparquet": "^1.32.0",
    "hyparquet-writer": "^0.18.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0"
}
