{
  "name": "@weisql/duckdb-adapter",
  "version": "0.2.0",
  "description": "Read-only DuckDB SqlAdapter for WeiSQL AI (Node.js)",
  "keywords": [
    "weisql",
    "duckdb",
    "sql",
    "parquet",
    "readonly",
    "nodejs"
  ],
  "homepage": "https://weisql.netlify.app/docs/adapters/duckdb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengjutian/WeiSQL.git",
    "directory": "packages/duckdb-adapter"
  },
  "bugs": {
    "url": "https://github.com/fengjutian/WeiSQL/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "test:watch": "npm run build && node --test --watch test/*.test.js"
  },
  "dependencies": {
    "@duckdb/node-api": "^2.0.0-r.1",
    "@weisql/sdk": "^0.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
