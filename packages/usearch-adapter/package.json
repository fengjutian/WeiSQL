{
  "name": "@weisql/usearch-adapter",
  "version": "0.1.0",
  "description": "ANN VectorAdapter for WeiSQL AI backed by USearch (Node.js)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
